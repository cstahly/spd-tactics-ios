<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>upload</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<!-- Manual signing: the ASC API key isn't Admin, so it can't use cloud-managed distribution certs.
	     Uses the local "Apple Distribution" cert and the "SPD Tactics App Store" profile. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.sadbabyrabbit.spdtactics</key>
		<string>SPD Tactics App Store</string>
	</dict>
	<key>teamID</key>
	<string>634QAM3ZHG</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
